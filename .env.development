# ==============================================================================
# BurnWatch 3D - Development Environment Configuration
# ==============================================================================

PROJECT_NAME="BurnWatch 3D - ISRO Component Screening Platform (Dev)"
ENVIRONMENT="development"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite for local offline development
DATABASE_URL="sqlite:///./burnwatch.db"

# Redis Event Bus with in-memory fallback enabled for local offline testing
REDIS_URL="redis://localhost:6379/0"
USE_REDIS_FALLBACK=true

TELEMETRY_BATCH_SIZE=100
TELEMETRY_RATE_LIMIT_PER_MINUTE=6000
MAX_PAYLOAD_SIZE_BYTES=5242880
CLOCK_SKEW_TOLERANCE_SECONDS=30.0

CHAMBER_TARGET_TEMP_C=125.0
BURN_IN_TOTAL_HOURS=168
EARLY_CHECKPOINT_HOURS=24

CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"
