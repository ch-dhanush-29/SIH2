# ==============================================================================
# BurnWatch 3D - Environment Configuration Template
# Problem Statement: SIH26170 (ISRO)
# ==============================================================================

PROJECT_NAME="BurnWatch 3D - ISRO Component Screening Platform"
ENVIRONMENT="production"

# Production Secret: Generate via `openssl rand -hex 32` or `python -c "import secrets; print(secrets.token_urlsafe(32))"`
# NEVER commit production secret keys to version control!
SECRET_KEY="CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_KEY"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL 16+ for Production)
DATABASE_URL="postgresql://burnwatch_user:secure_pg_password_here@postgres:5432/burnwatch_prod"

# Redis Event Bus (Pub/Sub & WebSocket Fanout)
REDIS_URL="redis://redis:6379/0"
USE_REDIS_FALLBACK=false

# Real-Time Telemetry & Rate Limiting
TELEMETRY_BATCH_SIZE=500
TELEMETRY_RATE_LIMIT_PER_MINUTE=6000
MAX_PAYLOAD_SIZE_BYTES=5242880
CLOCK_SKEW_TOLERANCE_SECONDS=10.0

# Chamber Thermal & Screening Parameters (MIL-STD-883H Class-S)
CHAMBER_TARGET_TEMP_C=125.0
BURN_IN_TOTAL_HOURS=168
EARLY_CHECKPOINT_HOURS=24

# CORS Origins (Comma-separated, no wildcard in production)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://burnwatch.isro.gov.in"
