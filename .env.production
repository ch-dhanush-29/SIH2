# ==============================================================================
# BurnWatch 3D - Production Environment Configuration
# ==============================================================================

PROJECT_NAME="BurnWatch 3D - ISRO Component Screening Platform"
ENVIRONMENT="production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=720

# PostgreSQL 16+ Production Cluster
DATABASE_URL="postgresql://burnwatch_user:secure_production_password@postgres:5432/burnwatch_prod"

# High-Availability Redis Event Bus
REDIS_URL="redis://redis:6379/0"
USE_REDIS_FALLBACK=false

TELEMETRY_BATCH_SIZE=500
TELEMETRY_RATE_LIMIT_PER_MINUTE=12000
MAX_PAYLOAD_SIZE_BYTES=10485760
CLOCK_SKEW_TOLERANCE_SECONDS=5.0

CHAMBER_TARGET_TEMP_C=125.0
BURN_IN_TOTAL_HOURS=168
EARLY_CHECKPOINT_HOURS=24

# Strict CORS for production (replace with actual production domain)
CORS_ORIGINS="https://burnwatch.isro.gov.in,http://localhost:3000"
